# Copy to backend.hcl and put your account ID in the bucket name (bucket is created by hand: docs/REMOTE-STATE.md).
bucket         = "eks-project-tfstate-<YOUR_ACCOUNT_ID>"
key            = "eks/terraform.tfstate"
region         = "eu-west-2"
encrypt        = true
use_lockfile   = true # lock via a .tflock file in the bucket (no DynamoDB needed)
